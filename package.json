{
  "name": "blocky-league",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/gen-assets.mjs",
    "build:web": "tsc --noEmit && node scripts/release.mjs web",
    "build:crazygames": "tsc --noEmit && node scripts/release.mjs crazygames",
    "build:poki": "tsc --noEmit && node scripts/release.mjs poki",
    "build:itch": "tsc --noEmit && node scripts/release.mjs itch",
    "build:ios": "tsc --noEmit && node scripts/release.mjs ios",
    "build:all": "tsc --noEmit && node scripts/release.mjs web crazygames poki itch",
    "submission": "node scripts/submission.mjs",
    "ios": "npm run build:itch && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "cordova-plugin-purchase": "^13.18.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
